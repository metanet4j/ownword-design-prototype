      "辅助文字": "rgb(80, 80, 80)",
      "主要文字": "rgb(41, 41, 41)",
      "背景端点": [
        "rgb(255, 255, 255)",
        "rgb(245, 249, 255)",
        "rgb(233, 233, 233)"
      ],
      "保守背景下界": "rgb(233, 233, 233)；白色高光只会使背景更亮，不再影响文字。",
      "辅助文字对比度下界": 6.64143576705589,
      "主要文字对比度下界": 11.98281864266975
    },
    "深色": {
