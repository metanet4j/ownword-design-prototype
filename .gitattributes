# Keep every text file in the repository as LF so Linux and Windows checkouts
# produce identical diffs. Binary assets (PNG, fonts, JSX bundles) are detected
# automatically and never converted.
* text=auto eol=lf

# Evidence is generated by the check scripts; keep it byte-stable across hosts.
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

*.png binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# 编辑器导出证据保留原始 CRLF，用于核对导出没有改写正文。
evidence/official-s2/editor-*/export.md -text
