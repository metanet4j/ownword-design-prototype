{
  "name": "ownword-content-prototype",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "build": "esbuild editor-tools.js --bundle --format=iife --global-name=OwnwordEditorTools --target=es2020 --supported:template-literal=false --outfile=vendor/editor-tools.js --minify",
    "check": "node check-model.cjs && node check-content.cjs && node check-markdown.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.3",
    "@milkdown/kit": "7.22.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
